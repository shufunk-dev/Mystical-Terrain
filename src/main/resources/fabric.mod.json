{
  "schemaVersion": 1,
  "id": "mysticalterrain",
  "version": "${version}",
  "name": "Mystical Terrain (Community Patch Edition)",
  "description": "Standalone community-patched edition of Mystical Terrain. Expanding Minecraft's Overworld, Nether, and The End with colossal trees, mysterious structures, epic bosses, and mythical gear. Originally created by VexiraRBX.",
  "authors": [
    "VexiraRBX (Original Author)",
    "Community Contributors"
  ],
  "contact": {
    "sources": "https://github.com/shufunk-dev/Mystical-Terrain"
  },
  "license": "CC0-1.0",
  "icon": "assets/mysticalterrain/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vexira.mysticalterrain.MysticalTerrain"
    ],
    "client": [
      "com.vexira.mysticalterrain.client.MysticalTerrainClient"
    ]
  },
  "mixins": [
    "mysticalterrain.mixins.json",
    {
      "config": "mysticalterrain.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-api": "*",
    "geckolib": ">=5.5.7"
  },
  "suggests": {
    "terrablender": "*"
  }
}
